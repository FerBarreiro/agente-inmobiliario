# Desarrollo local (valores por defecto; no contiene secretos)
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Producción: definir secretos sólo en la configuración protegida del proveedor,
# nunca en un archivo versionado ni en el navegador.
# NODE_ENV=production
# HOST=0.0.0.0
# TRUST_PROXY=1
# DATABASE_URL=postgresql://usuario:secreto@host/base?sslmode=require

# APP_ORIGIN sólo es necesaria al usar un dominio propio. En Render, si se omite,
# el servidor usa automáticamente el origen HTTPS RENDER_EXTERNAL_URL del servicio.
# APP_ORIGIN=https://app.tu-dominio.com

# Staging técnico excepcional con SQLite local; no permite datos personales reales.
# DATA_DIRECTORY=/var/lib/agente-inmobiliario
# ALLOW_LOCAL_SQLITE_IN_PRODUCTION=1
