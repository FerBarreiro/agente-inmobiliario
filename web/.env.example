# Desarrollo local (valores por defecto; no contiene secretos)
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Staging/producción: definir estos valores en la configuración protegida del proveedor,
# no en un archivo versionado ni en el navegador.
# NODE_ENV=production
# APP_ORIGIN=https://app.tu-dominio.com
# HOST=0.0.0.0
# PORT=8787
# DATA_DIRECTORY=/var/lib/agente-inmobiliario
# ALLOW_LOCAL_SQLITE_IN_PRODUCTION=1
# TRUST_PROXY=1

# ALLOW_LOCAL_SQLITE_IN_PRODUCTION sólo permite un staging técnico sin datos personales.
# Antes de operar con datos reales debe migrarse a una base administrada.
